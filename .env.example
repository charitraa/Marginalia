# Copy to `.env` and adjust. Never commit `.env`.

# Base URL of the Django API.
#
# Leave EMPTY for local development: vite.config.ts proxies /api and /media to
# the backend, so the browser sees a single origin and cookies stay first-party.
#
# Set it for deployed builds, e.g. https://api.marginalia.blog
# On Vercel this is a BUILD-TIME variable: Vite inlines it into the bundle, so
# changing it in the dashboard requires a redeploy, not just a restart.
VITE_API_BASE_URL=

# Where the dev proxy forwards to. Only used by `npm run dev`.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
